{
  "name": "@azuliani/tree-diff",
  "version": "0.0.3",
  "description": "Tree/trie-based JSON-friendly diff and strict patcher.",
  "keywords": [
    "diff",
    "patch",
    "delta",
    "trie",
    "tree",
    "json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azuliani/tree-diff.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:esm && npm run build:cjs",
    "build:cjs": "tsc -p tsconfig.build.cjs.json && node ./scripts/write-cjs-package-json.mjs",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:types": "tsc -p tsconfig.build.types.json",
    "bench": "node ./bench/run.ts",
    "bench:gc": "node --expose-gc ./bench/run.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck && npm run test:dist",
    "profile:cpu": "mkdir -p .profiles && node --expose-gc --cpu-prof --cpu-prof-dir .profiles ./bench/profile.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test ./test/tree-diff.test.ts",
    "lint": "eslint .",
    "test:dist": "npm run build && node --test ./test/dist-exports.test.cjs"
  },
  "devDependencies": {
    "@azuliani/deep-diff": "^1.0.2",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.13.4",
    "eslint": "^9.39.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
